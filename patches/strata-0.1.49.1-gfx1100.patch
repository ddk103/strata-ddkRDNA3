+namespace {
+// #3431 (ported from 0.1.54+): on Windows the HIP runtime gives every cudaHostRegister'ed range a second address for the
+// GPU (its alias) and takes any host pointer inside that alias for the registered memory.  The alias is not reserved in
+// the process's own address space, so a thread stack, a heap block or a mapping can sit there: in about one start in ten
+// on an RX 7900 XTX the engine thread's stack did, and every long prompt was read wrong until the process ended, with no
+// error.  The alias range is reserved here (address space only, nothing committed), and a range whose alias already
+// covers memory in use is not registered: the caller's "the driver refused it" path applies to it.
+// main() reserves the free address space below 1 TiB and runs the engine on its own thread (generate.cpp), so the
+// stacks and later allocations sit above the aliases; STRATA_STACK_ISOLATE=0 turns the whole fix off.
+std::atomic<uint64_t> g_idle_stack_lo{0}, g_idle_stack_hi{0};
+std::vector<uint64_t> g_held;            // main()'s reservations below 1 TiB
+std::vector<void*> g_alias_claims;       // the alias ranges reserved for registered ranges (process lifetime)
+bool alias_fix_on() {
+    static const bool on = [] { const char* e = std::getenv("STRATA_STACK_ISOLATE"); return e == nullptr || e[0] != '0'; }();
+    return on;
+}
+#if defined(_WIN32)
+bool claim_alias(void* host, uint64_t n, std::string& why) {
+    void* d = nullptr;
+    if (!alias_fix_on() || cudaHostGetDevicePointer(&d, host, 0) != cudaSuccess || d == nullptr || d == host) {
+        (void) cudaGetLastError();
+        return true;
+    }
+    SYSTEM_INFO si;
+    GetSystemInfo(&si);
+    const uint64_t gran = si.dwAllocationGranularity;
+    const uint64_t top = (uint64_t) si.lpMaximumApplicationAddress;
+    const uint64_t a = (uint64_t) d, end = std::min<uint64_t>(a + n, top);
+    std::vector<void*> got;
+    MEMORY_BASIC_INFORMATION mbi;
+    char msg[256] = "";
+    uint64_t at = a;
+    const uint64_t a0 = a & ~(gran - 1);
+    if (a0 < a && a0 < end && VirtualQuery((void*) a0, &mbi, sizeof mbi) == sizeof mbi && mbi.State == MEM_FREE &&
+        (uint64_t) mbi.BaseAddress + mbi.RegionSize > a)
+        at = a0;
+    while (at < end) {
+        if (VirtualQuery((void*) at, &mbi, sizeof mbi) != sizeof mbi) {
+            std::snprintf(msg, sizeof msg, "VirtualQuery failed at %#llx", (unsigned long long) at);
+            break;
+        }
+        const uint64_t re = std::min<uint64_t>((uint64_t) mbi.BaseAddress + mbi.RegionSize, end);
+        const uint64_t idle_lo = g_idle_stack_lo.load(), idle_hi = g_idle_stack_hi.load();
+        const bool held = mbi.State == MEM_RESERVE && std::binary_search(g_held.begin(), g_held.end(), (uint64_t) mbi.AllocationBase);
+        const bool idle = mbi.State != MEM_FREE && idle_lo < idle_hi && (uint64_t) mbi.AllocationBase == idle_lo && re <= idle_hi;
+        if (held || idle) {   // main()'s reservation, or the first thread's stack (it only waits from here on)
+            at = (uint64_t) mbi.BaseAddress + mbi.RegionSize;
+            continue;
+        }
+        if (mbi.State != MEM_FREE) {
+            ULONG_PTR lo = 0, hi = 0;
+            GetCurrentThreadStackLimits(&lo, &hi);
+            const bool own_stack = at < (uint64_t) hi && (uint64_t) lo < re;
+            const char* kind = own_stack ? "this thread's stack" : mbi.Type == MEM_IMAGE ? "a module" :
+                               mbi.Type == MEM_MAPPED ? "a mapped view" : "private memory";
+            std::snprintf(msg, sizeof msg, "the GPU alias [%#llx, +%llu MiB) of the range at %p covers memory in use at %#llx (%s, from %p)",
+                          (unsigned long long) a, (unsigned long long) (n >> 20), host, (unsigned long long) at, kind,
+                          mbi.AllocationBase);
+            break;
+        }
+        const uint64_t b = (at + gran - 1) & ~(gran - 1);   // a free piece inside a granule shares it: nothing new starts there
+        if (b < re) {
+            void* r = VirtualAlloc((void*) b, (SIZE_T) (re - b), MEM_RESERVE, PAGE_NOACCESS);
+            if (r == nullptr) {
+                std::snprintf(msg, sizeof msg, "could not reserve the GPU alias [%#llx, +%llu MiB) of the range at %p (error %lu)",
+                              (unsigned long long) a, (unsigned long long) (n >> 20), host, GetLastError());
+                break;
+            }
+            got.push_back(r);
+        }
+        at = (uint64_t) mbi.BaseAddress + mbi.RegionSize;
+    }
+    if (msg[0] != '\0') {
+        for (void* g : got) VirtualFree(g, 0, MEM_RELEASE);
+        why = msg;
+        return false;
+    }
+    g_alias_claims.insert(g_alias_claims.end(), got.begin(), got.end());
+    return true;
+}
+#endif
+
+cudaError_t pin_register_checked(void* p, size_t n, unsigned flags) {
+    const cudaError_t e = pin_register(p, n, flags);
+#if defined(_WIN32)
+    if (e == cudaSuccess) {
+        std::string why;
+        if (!claim_alias(p, (uint64_t) n, why)) {
+            (void) pin_unregister(p);
+            (void) cudaGetLastError();
+            std::fprintf(stderr, "strata pin: %s; that range stays unregistered (#3431)\n", why.c_str());
+            return cudaErrorMemoryAllocation;
+        }
+    }
+#else
+    (void) p; (void) n; (void) flags;
+#endif
+    return e;
+}
+}  // namespace
+
+void strata::core::set_idle_thread_stack(uint64_t lo, uint64_t hi) {
+    g_idle_stack_lo.store(lo);
+    g_idle_stack_hi.store(hi);
+}
+
+void strata::core::set_held_address_space(std::vector<uint64_t> bases) {
+    std::sort(bases.begin(), bases.end());
+    g_held = std::move(bases);
+}
